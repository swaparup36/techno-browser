new file mode 100644
index 0000000..a712c33
--- /dev/null
+++ b/tests/ws_registration.rs
@@ -0,0 +1,107 @@
+use hbb_common::{
+    futures_util::{SinkExt, StreamExt},
+    protobuf::Message as _,
+    rendezvous_proto::{
+        register_pk_response, rendezvous_message, PunchHoleRequest, RegisterPk, RendezvousMessage,
+    },
+    tokio::{
+        self,
+        time::{sleep, timeout, Duration},
+    },
+};
+use std::{
+    net::TcpListener,
+    process::{Child, Command, Stdio},
+};
+use tokio_tungstenite::{connect_async, tungstenite::Message};
+
+struct Server(Child);
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+#[tokio::test]
+async fn websocket_registration_receives_punch_request() {
+    let port = loop {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        if port < 65_533 {
+            break port;
+        }
+    };
+    let server_dir =
+        std::env::temp_dir().join(format!("hbbs-wss-test-{}-{port}", std::process::id()));
+    std::fs::create_dir_all(&server_dir).unwrap();
+    let bin = std::env::var("CARGO_BIN_EXE_hbbs").unwrap();
+    let mut command = Command::new(bin);
+    command
+        .args(["-b", "127.0.0.1", "-p", &port.to_string(), "-k", "test-key"])
+        .current_dir(&server_dir)
+        .stdout(Stdio::null())
+        .stderr(Stdio::null());
+    let _server = Server(command.spawn().unwrap());
+    let endpoint = format!("ws://127.0.0.1:{}/ws/id", port + 2);
+
+    let mut host = timeout(Duration::from_secs(5), async {
+        loop {
+            if let Ok((socket, _)) = connect_async(&endpoint).await {
+                break socket;
+            }
+            sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await
+    .unwrap();
+    let mut register = RendezvousMessage::new();
+    register.set_register_pk(RegisterPk {
+        id: "123456789".into(),
+        uuid: vec![1; 16].into(),
+        pk: vec![2; 32].into(),
+        ..Default::default()
+    });
+    host.send(Message::Binary(register.write_to_bytes().unwrap()))
+        .await
+        .unwrap();
+    let response = timeout(Duration::from_secs(5), host.next())
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    let response = RendezvousMessage::parse_from_bytes(&response.into_data()).unwrap();
+    let Some(rendezvous_message::Union::RegisterPkResponse(response)) = response.union else {
+        panic!("expected RegisterPkResponse");
+    };
+    assert_eq!(
+        response.result.enum_value().unwrap(),
+        register_pk_response::Result::OK
+    );
+
+    let (mut controller, _) = connect_async(&endpoint).await.unwrap();
+    let mut request = RendezvousMessage::new();
+    request.set_punch_hole_request(PunchHoleRequest {
+        id: "123456789".into(),
+        licence_key: "test-key".into(),
+        ..Default::default()
+    });
+    controller
+        .send(Message::Binary(request.write_to_bytes().unwrap()))
+        .await
+        .unwrap();
+    let punch = timeout(Duration::from_secs(5), async {
+        loop {
+            let message = host.next().await.unwrap().unwrap();
+            if let Ok(message) = RendezvousMessage::parse_from_bytes(&message.into_data()) {
+                if let Some(rendezvous_message::Union::PunchHole(punch)) = message.union {
+                    break punch;
+                }
+            }
+        }
+    })
+    .await
+    .unwrap();
+    assert!(!punch.socket_addr.is_empty());
+}
